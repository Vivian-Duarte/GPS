# Chave secreta utilizada pelo Django para assinaturas e segurança.
# Cada desenvolvedor deve gerar sua própria chave no arquivo .env.
SECRET_KEY=troque-por-uma-chave-gerada

# Ativa o modo de desenvolvimento do Django.
# Em produção, deve ser False.
DEBUG=True

# Hosts autorizados a acessar o backend.
# Os valores são separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
